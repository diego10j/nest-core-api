# =============================================================================
# nest-core-api — variables de entorno
# Copiar este archivo a ".env" y completar los valores. NUNCA subir el .env al repositorio.
# Obligatorias: sin ellas el backend no arranca. Opcionales: están comentadas (#) o tienen valor por defecto.
# =============================================================================

# ----------------------------------------------------------------- Base de datos
# Cadena de conexión PostgreSQL (usuario, clave, host, puerto y base)
DB_URL_POOL=postgresql://USUARIO:CLAVE@HOST:5432/BASE?sslmode=require

# ----------------------------------------------------------------- Aplicación
# DEV / PROD
MODE=DEV
PORT=3000
# Id del sistema en sis_sistema (filtra menús y opciones del ERP)
ID_SISTEMA=2

# URL pública de ESTE backend, sin barra final ni ruta (ej. https://api.miempresa.com).
# Con ella se arman los links de archivos (/api/sistema/files/downloadFile/...): debe ser el mismo
# servidor que recibe las subidas, porque los archivos viven en su disco (PATH_DRIVE).
HOST_API=http://localhost:3000

# Carpeta donde se guardan los archivos subidos, firmas, imágenes y adjuntos
PATH_DRIVE=/ruta/al/drive

# Formatos de fecha/hora de la base de datos (no cambiar si no se sabe)
FORMAT_DATE_BD=yyyy-MM-dd
FORMAT_TIME_BD=HH:mm:ss

# ----------------------------------------------------------------- Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------------------- Seguridad / sesiones
# Generar cada secreto con: openssl rand -base64 64   (JWT_SECRET y JWT_REFRESH_SECRET deben ser distintos)
# Access token: corta duración
JWT_SECRET=<REEMPLAZAR_CON_SECRETO_FUERTE>
JWT_SECRET_EXPIRES_TIME=15m
# Refresh token: larga duración. Si falta se usa un valor público: el backend lo avisa al arrancar.
JWT_REFRESH_SECRET=<REEMPLAZAR_CON_OTRO_SECRETO_FUERTE>
JWT_REFRESH_EXPIRES_TIME=7d

# Guard de autenticación global: enforce (por defecto, rechaza peticiones sin token) o warn
# (solo registra "[warn-mode]" en el log; usar en el primer despliegue y volver a enforce).
# AUTH_GUARD_MODE=enforce

# Clave con la que se cifran en la BD la clave de la firma electrónica del SRI y las credenciales
# de Telegram/Groq. Cada instalación debe tener la suya (nunca copiar la de otra):
#   1) openssl rand -base64 32   (44 caracteres, termina en "=")
#   2) Quitar el "#" de la línea de abajo y pegar el resultado.
#   3) Guardarla FUERA del servidor (gestor de contraseñas): si se pierde, lo cifrado no se recupera.
#   4) Reiniciar el backend.
# Sin ella se usa una clave antigua escrita en el código (pública): el backend lo avisa al arrancar.
# SRI_ENCRYPTION_KEY=<resultado de: openssl rand -base64 32>

# URL de inicio de sesión del ERP: botón del correo con la contraseña temporal. Opcional.
# APP_LOGIN_URL=https://erp.miempresa.com

# ----------------------------------------------------------------- WhatsApp
# Puerto de los sockets de WhatsApp y notificaciones
WHATSAPP_SOCKET_PORT=3003

# ----------------------------------------------------------------- Inteligencia artificial / OCR
OPENAI_API_KEY=<REEMPLAZAR>
OCR_SPACE_API_KEY=<REEMPLAZAR>
OCR_SPACE_TIMEOUT_MS=30000

# ----------------------------------------------------------------- YCloud (WhatsApp, opcional)
# YCLOUD_API_KEY=<REEMPLAZAR>
# YCLOUD_WEBHOOK_VERIFY_TOKEN=<REEMPLAZAR>
# YCLOUD_API_URL=https://api.ycloud.com/v2
